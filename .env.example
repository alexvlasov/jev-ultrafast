# Vercel AI Gateway key: routes both Jev (decisions) and the text helper (TYPE_TEXT).
AI_GATEWAY_API_KEY=
TYPESAFE_MODEL=typesafe-ai/jev
# Text helper defaults to AI Gateway's OpenAI-compatible endpoint with the key above.
# Set TEXT_MODEL_API_KEY and TEXT_MODEL_BASE_URL only to use a different provider.
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
